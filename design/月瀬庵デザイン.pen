          "width": "fill_container",
          "descendants": {
            "XWHD1": {
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "./images/generated-1771721118020.png",
                "mode": "fill"
              }
            },
            "72qoo": {
              "content": "BREAKFAST"
            },
            "akMmx": {
              "content": "朝餉"
            },
            "hUsSl": {
              "content": "箱根の朝を迎える、心温まる朝餉。\n炊きたての土鍋ご飯、焼き魚、\n地元の豆腐や漬物を中心に、\n滋味深い和朝食をご用意いたします。\n\n朝の芦ノ湖を眺めながら、\n旅の朝を彩るひとときをお過ごしください。"
            }
          }
        },
        {
          "id": "aSYUr",
          "type": "ref",
          "ref": "cdmD5",
          "name": "Dining Room Section",
          "width": "fill_container",
          "descendants": {
            "4cu1c": {
