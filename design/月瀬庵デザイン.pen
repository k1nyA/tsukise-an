          },
          "name": "cuisineTC",
          "descendants": {
            "CuSSF": {
              "content": "PHILOSOPHY"
            },
            "m5TG8": {
              "content": "土地の恵みを、一皿に。"
            },
            "tErAe": {
              "content": "月瀬庵の料理長・水月が手掛ける月替わり懐石は、\n箱根・小田原の海と山が育む食材を軸に、\n季節の移ろいを一皿一皿に映し出します。\n\n器は地元の作家による特注品。\n目で愉しみ、香りで感じ、舌で味わう\n五感のすべてに響く料理をお届けいたします。"
            }
          }
        },
        {
          "id": "mkBLd",
          "type": "ref",
          "ref": "InbGq",
          "width": "fill_container",
          "name": "tabKRef"
        },
        {
          "id": "SOoWP",
          "type": "ref",
          "ref": "cdmD5",
          "name": "Ingredients Section",
          "width": "fill_container",
          "descendants": {
            "4cu1c": {
              "fill": "#F0EBE0"
            },
            "9Y8sm": {
              "content": "INGREDIENTS"
            },
            "kzj9c": {
              "content": "食材へのこだわり"
            },
            "GgQO6": {
              "content": "小田原漁港から届く朝獲れの鮮魚、\n箱根の山が育む山菜や茸、\n地元農家から届く有機野菜。\n\n料理長自ら毎朝市場に足を運び、\nその日最も旬を迎えた素材だけを\n厳選して仕入れています。\n\n「この土地でしか味わえない一皿」を\nお届けすることが私たちの誇りです。"
            },
            "kjevo": {
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "./images/generated-1771721082355.png",
                "mode": "fill"
              }
            }
